# Option A: route every model call through OpenRouter (one key for open + closed models)
# OPENROUTER_API_KEY=sk-or-v1-...
# USE_OPENROUTER=1

# Option B: provider keys directly
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Option C: self-hosted open-weight model (vllm serve ... --enable-auto-tool-choice --tool-call-parser hermes)
# VLLM_BASE_URL=http://<gpu-box>:8000/v1

# Pull prebuilt environment images from Docker Hub instead of building (~10 min/env saved)
SKIP_DOCKER_BUILD=1

# Docker Hub allows ~10 anonymous pulls/hour per IP; a 9-env run needs ~36 images. Log in, or
# pre-pull with scripts/prepull_images.py (waits out the limit) and run with SKIP_DOCKER_PULL=1.
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
